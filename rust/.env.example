# ============================
# CodePush Server (Rust) Config
# ============================

# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- Database ---
# SQLite file path (relative to rust/ directory or absolute)
DATABASE_URL=sqlite://../data/codepush.db

# --- JWT ---
# Secret key for JWT token. Recommended: 63 random alpha-numeric characters
# Also supports legacy TOKEN_SECRET from Node.js version
JWT_TOKEN_SECRET=INSERT_RANDOM_TOKEN_KEY

# --- Redis ---
# Required for: login rate limiting, register code, update check cache, rollout cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Storage ---
# Storage type: "local" (default). Cloud options not yet supported in Rust version.
STORAGE_TYPE=local

# Local storage directory for uploaded packages
# Also supports legacy LOCAL_STORAGE_DIR
STORAGE_DIR=../data-storage

# Download URL for clients to fetch packages
# Also supports DOWNLOAD_URL as fallback
LOCAL_DOWNLOAD_URL=http://127.0.0.1:3000/download

# --- Common ---
# Allow new user registration (true/false or 1/0). Default: false
ALLOW_REGISTRATION=true

# Login attempt limit per day (0 = unlimited). Requires Redis.
TRY_LOGIN_TIMES=4

# Number of diff (delta update) packages to generate. Default: 3
DIFF_NUMS=3

# Temporary directory for diff calculation
DATA_DIR=/tmp

# Cache updateCheck results in Redis (true/false or 1/0)
UPDATE_CHECK_CACHE=false

# Cache rollout client unique ID in Redis (true/false or 1/0)
ROLLOUT_CLIENT_UNIQUE_ID_CACHE=false

# --- SMTP (Email) ---
# Required for sending registration verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password

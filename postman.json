  "item": [
    {
      "name": "1. Auth & Account",
      "item": [
        {
          "name": "Đăng nhập (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lưu access_token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results && jsonData.results.tokens) {",
                  "        pm.environment.set(\"access_token\", jsonData.results.tokens);",
                  "        pm.collectionVariables.set(\"access_token\", jsonData.results.tokens);",
                  "        console.log(\"access_token: \" + jsonData.results.tokens);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Đăng xuất (Logout)",

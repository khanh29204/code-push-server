    {
      "name": "7. Client SDK Update API",
      "item": [
        {
          "name": "Client Kiểm tra bản cập nhật (Update Check)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/updateCheck?deployment_key=YOUR_DEPLOYMENT_KEY&app_version=1.0.0&package_hash=&label=&client_unique_id=device123",
              "host": ["{{base_url}}"],
              "path": ["updateCheck"],
              "query": [
                {
                  "key": "deployment_key",
                  "value": "YOUR_DEPLOYMENT_KEY"
                },
                {
                  "key": "app_version",
                  "value": "1.0.0"
                },
                {
                  "key": "package_hash",
                  "value": ""
                },
                {
                  "key": "label",
                  "value": ""
                },
                {
                  "key": "client_unique_id",
                  "value": "device123"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Client Báo cáo đã tải xong (Report Download Status)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],

          "name": "Phát hành bản cập nhật mới (Release Package - Multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "packageInfo",
                  "value": "{\"appVersion\":\"1.0.0\",\"description\":\"Cập nhật tính năng mới\",\"isMandatory\":false,\"isDisabled\":false,\"rollout\":100}",
